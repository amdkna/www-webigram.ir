# Local/runtime secrets. Do not commit real values.
CHECKMARKS_API_USERNAME=
CHECKMARKS_API_PASSWORD=

# Optional: enables WordPress/plugin/theme vulnerability lookup.
# Use a WPScan API plan/license appropriate for this public service.
WPSCAN_API_TOKEN=

# WordPress Doctor abuse protection defaults.
WORDPRESS_DOCTOR_RATE_LIMIT=6
WORDPRESS_DOCTOR_QUICK_CACHE_TTL_MS=900000
WORDPRESS_DOCTOR_TARGET_RATE_WINDOW_MS=3600000
WORDPRESS_DOCTOR_TARGET_MAX_FRESH=2
WORDPRESS_DOCTOR_DEEP_RATE_WINDOW_MS=600000
WORDPRESS_DOCTOR_DEEP_MAX_FRESH=2
WORDPRESS_DOCTOR_MAIL_RATE_WINDOW_MS=3600000
WORDPRESS_DOCTOR_MAIL_MAX_SENDS=3
WORDPRESS_DOCTOR_GLOBAL_FRESH_WINDOW_MS=60000
WORDPRESS_DOCTOR_GLOBAL_MAX_FRESH=30
WORDPRESS_DOCTOR_DEST_IP_RATE_WINDOW_MS=60000
WORDPRESS_DOCTOR_DEST_IP_MAX_FRESH=12
