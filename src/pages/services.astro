---
import '../styles/base.css';

const base = import.meta.env.BASE_URL;
const cmsUrl = 'https://cms.webigram.ir';

const fallbackServices = [
  {
    slug: 'devops-infrastructure',
    title: 'DevOps و زیرساخت',
    icon: '⌁',
    featured: true,
    summary: 'از CI/CD و Docker تا مانیتورینگ، امنیت و معماری استقرار؛ زیرساختی می سازیم که قابل اتکا، قابل توسعه و قابل نگهداری باشد.',
    details: 'طراحی Pipeline، کانتینرسازی، استقرار روی سرور و Cloud، Reverse Proxy، SSL، مانیتورینگ، Backup و مدیریت محیط های توسعه و Production.',
    tags: ['CI/CD', 'Docker', 'Linux', 'Nginx', 'Monitoring'],
    cta_label: 'مشاوره DevOps',
    cta_url: '/#real',
  },
  {
    slug: 'automation',
    title: 'اتوماسیون و یکپارچه سازی',
    icon: '⚡',
    featured: true,
    summary: 'کارهای تکراری را حذف می کنیم و سیستم ها را به هم وصل می کنیم تا فرآیندهای واقعی مجموعه با دخالت انسانی کمتر و خطای پایین تر اجرا شوند.',
    details: 'طراحی Workflow، اتصال APIها، فرم ها و CRM، اعلان ها، گزارش گیری، Botها، پردازش فایل و داده و ساخت اتوماسیون های اختصاصی.',
    tags: ['Automation', 'API', 'Workflow', 'Integration', 'Bots'],
    cta_label: 'بررسی فرآیند',
    cta_url: '/#real',
  },
  {
    slug: 'platform-development',
    title: 'طراحی و ساخت پلتفرم',
    icon: '◈',
    featured: true,
    summary: 'از یک مسئله یا ایده اولیه تا محصول قابل استفاده؛ معماری، تجربه کاربری، Backend، Frontend و استقرار را به صورت یک مسیر یکپارچه جلو می بریم.',
    details: 'برای پلتفرم های اختصاصی، MVP، SaaS و محصولات داخلی، ابتدا مسئله و جریان کار را مدل می کنیم و بعد راهکار را مرحله به مرحله می سازیم.',
    tags: ['Platform', 'MVP', 'SaaS', 'Backend', 'Frontend'],
    cta_label: 'شروع طراحی پلتفرم',
    cta_url: '/#real',
  },
  {
    slug: 'enterprise-panels',
    title: 'پنل های سازمانی و داشبورد',
    icon: '▦',
    featured: false,
    summary: 'پنل مدیریتی و ابزار داخلی را دقیقا مطابق فرآیند سازمان می سازیم؛ نه اینکه سازمان را مجبور کنیم خودش را با یک نرم افزار عمومی تطبیق دهد.',
    details: 'پنل های مدیریت، داشبوردهای عملیاتی، سیستم های ثبت و پیگیری، گزارش ها، نقش ها و سطح دسترسی، گردش تایید و ابزارهای داخلی تحت وب.',
    tags: ['Admin Panel', 'Dashboard', 'RBAC', 'Reporting', 'Internal Tools'],
    cta_label: 'طراحی پنل سازمانی',
    cta_url: '/#real',
  },
  {
    slug: 'web-development',
    title: 'وب سایت و وب اپلیکیشن',
    icon: '◎',
    featured: false,
    summary: 'سایت شرکتی، لندینگ، ابزار آنلاین یا Web App را با تمرکز روی سرعت، تجربه کاربری، سئو و قابلیت توسعه در آینده طراحی و پیاده سازی می کنیم.',
    details: 'طراحی رابط، توسعه Frontend و Backend، اتصال CMS، فرم ها، سئو فنی، Analytics، بهینه سازی سرعت و استقرار کامل پروژه.',
    tags: ['Website', 'Web App', 'SEO', 'CMS', 'Performance'],
    cta_label: 'ساخت وب سایت',
    cta_url: '/#real',
  },
  {
    slug: 'ai-solutions',
    title: 'راهکارهای هوش مصنوعی',
    icon: '✦',
    featured: false,
    summary: 'هوش مصنوعی را جایی وارد محصول و فرآیند می کنیم که واقعا ارزش ایجاد کند؛ از دستیار داخلی تا پردازش متن، جستجو و Agentهای متصل به ابزارها.',
    details: 'اتصال مدل های زبانی به داده و ابزارهای سازمان، RAG، دستیارهای داخلی، طبقه بندی و استخراج اطلاعات و Agentهای کنترل شده برای وظایف مشخص.',
    tags: ['AI', 'LLM', 'RAG', 'Agents', 'Knowledge Base'],
    cta_label: 'بررسی کاربرد AI',
    cta_url: '/#real',
  },
];

const fallbackPage = {
  hero_kicker: 'خدمات وبیگرام',
  hero_title_before: 'برای هر مسئله،',
  hero_title_highlight: 'راه حل درست',
  hero_title_after: 'را می سازیم.',
  hero_description: 'از زیرساخت و DevOps تا اتوماسیون، پلتفرم، پنل سازمانی و وب سایت؛ اول مسئله را می فهمیم و بعد دقیقا همان چیزی را طراحی و اجرا می کنیم که لازم است.',
  cta_kicker: 'یک مسئله یا ایده دارید؟',
  cta_title: 'از مسئله شروع کنیم.\nراه حل را با هم می سازیم.',
  cta_description: 'لازم نیست از قبل بدانید چه تکنولوژی یا چه نوع نرم افزاری می خواهید. مسئله و نتیجه مورد انتظار را بگویید؛ مسیر فنی را ما طراحی می کنیم.',
  cta_button_label: 'شروع گفتگو',
  cta_button_url: '/#real',
  seo_title: 'خدمات وبیگرام | DevOps، اتوماسیون، پلتفرم و طراحی سایت',
  seo_description: 'خدمات وبیگرام شامل DevOps و زیرساخت، اتوماسیون، طراحی پلتفرم، پنل های سازمانی، وب سایت و راهکارهای هوش مصنوعی است.',
};
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#fbfaf7" />
  <meta name="description" content={fallbackPage.seo_description} data-cms-meta="description" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://webigram.ir/services/" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>{fallbackPage.seo_title}</title>
</head>
<body class="services-page" data-cms-collection="services">
  <header class="services-header">
    <div class="services-shell services-nav-wrap">
      <a class="services-brand" href={`${base}`} aria-label="وبیگرام - خانه">
        <svg viewBox="0 0 64 52" aria-hidden="true"><path d="M4 7 16 45 28 14l8 31L60 7"/><path class="echo" d="M7 9 17 41 28 17l8 25L57 9"/></svg>
        <strong>Webigram</strong>
      </a>
      <nav aria-label="منوی اصلی">
        <a href={`${base}`}>خانه</a>
        <a class="active" href={`${base}services/`}>خدمات</a>
        <a href={`${base}#color`}>نمونه کارها</a>
        <a href={`${base}#real`}>درباره ما</a>
        <a href={`${base}#real`}>تماس با ما</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="services-hero services-shell">
      <div class="hero-kicker"><span></span><b data-cms-field="hero_kicker">{fallbackPage.hero_kicker}</b></div>
      <h1>
        <span data-cms-field="hero_title_before">{fallbackPage.hero_title_before}</span><br/>
        <em data-cms-field="hero_title_highlight">{fallbackPage.hero_title_highlight}</em>
        <span data-cms-field="hero_title_after"> {fallbackPage.hero_title_after}</span>
      </h1>
      <div class="hero-copy">
        <p data-cms-field="hero_description">{fallbackPage.hero_description}</p>
        <a class="hero-action" href="#services-list">مشاهده خدمات <span>↓</span></a>
      </div>
    </section>

    <section class="services-intro services-shell">
      <span>WHAT WE DO</span>
      <p>خدمت برای ما یک عنوان روی بروشور نیست. هر پروژه با شناخت مسئله شروع می شود و ترکیب خدمات بر اساس همان مسئله شکل می گیرد.</p>
    </section>

    <section class="services-list services-shell" id="services-list" aria-label="لیست خدمات وبیگرام" data-services-grid>
      {fallbackServices.map((service, index) => (
        <article class:list={['service-card', service.featured && 'featured']} data-service-slug={service.slug}>
          <div class="service-topline">
            <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="service-icon" aria-hidden="true">{service.icon}</span>
          </div>
          <h2>{service.title}</h2>
          <p class="service-summary">{service.summary}</p>
          <p class="service-details">{service.details}</p>
          <div class="service-bottom">
            <div class="service-tags" aria-label={`تکنولوژی ها و حوزه های ${service.title}`}>
              {service.tags.map((tag) => <span>{tag}</span>)}
            </div>
            {service.cta_label && service.cta_url && (
              <a class="service-link" href={service.cta_url}>{service.cta_label}<span>←</span></a>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="services-cta services-shell">
      <div class="cta-copy">
        <span class="cta-label" data-cms-field="cta_kicker">{fallbackPage.cta_kicker}</span>
        <h2 data-cms-field="cta_title">{fallbackPage.cta_title}</h2>
        <p data-cms-field="cta_description">{fallbackPage.cta_description}</p>
      </div>
      <a class="cta-button" href={fallbackPage.cta_button_url} data-cms-link="cta_button_url">
        <span data-cms-field="cta_button_label">{fallbackPage.cta_button_label}</span><b>←</b>
      </a>
    </section>
  </main>

  <footer class="services-footer services-shell">
    <span>Webigram</span>
    <span>DevOps · Automation · Platforms · Web</span>
  </footer>

  <script define:vars={{ cmsUrl }} is:inline>
    (() => {
      const timeout = 5000;

      const fetchJson = async (path) => {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeout);
        try {
          const response = await fetch(`${cmsUrl}${path}`, {
            headers: { Accept: 'application/json' },
            cache: 'no-store',
            signal: controller.signal,
          });
          if (!response.ok) throw new Error(`CMS HTTP ${response.status}`);
          return await response.json();
        } finally {
          clearTimeout(timer);
        }
      };

      const normalizeTags = (value) => {
        if (Array.isArray(value)) return value.filter(Boolean).map(String);
        if (typeof value !== 'string' || !value.trim()) return [];
        try {
          const parsed = JSON.parse(value);
          return Array.isArray(parsed) ? parsed.filter(Boolean).map(String) : [];
        } catch {
          return value.split(',').map((item) => item.trim()).filter(Boolean);
        }
      };

      const setText = (field, value) => {
        if (typeof value !== 'string' || !value.trim()) return;
        const element = document.querySelector(`[data-cms-field="${field}"]`);
        if (element) element.textContent = value;
      };

      const applyPageContent = (page) => {
        if (!page) return;
        [
          'hero_kicker',
          'hero_title_before',
          'hero_title_highlight',
          'hero_title_after',
          'hero_description',
          'cta_kicker',
          'cta_title',
          'cta_description',
          'cta_button_label',
        ].forEach((field) => setText(field, page[field]));

        const cta = document.querySelector('[data-cms-link="cta_button_url"]');
        if (cta && typeof page.cta_button_url === 'string' && page.cta_button_url.trim()) {
          cta.setAttribute('href', page.cta_button_url);
        }

        if (typeof page.seo_title === 'string' && page.seo_title.trim()) {
          document.title = page.seo_title;
        }

        const description = document.querySelector('[data-cms-meta="description"]');
        if (description && typeof page.seo_description === 'string' && page.seo_description.trim()) {
          description.setAttribute('content', page.seo_description);
        }
      };

      const createServiceCard = (service, index) => {
        const article = document.createElement('article');
        article.className = `service-card${service.featured ? ' featured' : ''}`;
        if (service.slug) article.dataset.serviceSlug = service.slug;

        const topLine = document.createElement('div');
        topLine.className = 'service-topline';

        const number = document.createElement('span');
        number.className = 'service-number';
        number.textContent = String(index + 1).padStart(2, '0');

        const icon = document.createElement('span');
        icon.className = 'service-icon';
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = service.icon || '◈';

        topLine.append(number, icon);

        const title = document.createElement('h2');
        title.textContent = service.title || '';

        const summary = document.createElement('p');
        summary.className = 'service-summary';
        summary.textContent = service.summary || '';

        const details = document.createElement('p');
        details.className = 'service-details';
        details.textContent = service.details || '';

        const bottom = document.createElement('div');
        bottom.className = 'service-bottom';

        const tags = document.createElement('div');
        tags.className = 'service-tags';
        tags.setAttribute('aria-label', `حوزه های ${service.title || 'خدمت'}`);
        normalizeTags(service.tags).forEach((tag) => {
          const chip = document.createElement('span');
          chip.textContent = tag;
          tags.appendChild(chip);
        });
        bottom.appendChild(tags);

        if (service.cta_label && service.cta_url) {
          const link = document.createElement('a');
          link.className = 'service-link';
          link.href = service.cta_url;
          link.append(document.createTextNode(service.cta_label));
          const arrow = document.createElement('span');
          arrow.textContent = '←';
          link.appendChild(arrow);
          bottom.appendChild(link);
        }

        article.append(topLine, title, summary);
        if (service.details) article.appendChild(details);
        article.appendChild(bottom);
        return article;
      };

      const applyServices = (services) => {
        if (!Array.isArray(services) || services.length === 0) return;
        const grid = document.querySelector('[data-services-grid]');
        if (!grid) return;
        const fragment = document.createDocumentFragment();
        services.forEach((service, index) => fragment.appendChild(createServiceCard(service, index)));
        grid.replaceChildren(fragment);
      };

      Promise.allSettled([
        fetchJson('/items/services?fields=id,sort,slug,title,summary,details,icon,tags,featured,cta_label,cta_url&filter[status][_eq]=published&sort=sort'),
        fetchJson('/items/services_page?fields=id,hero_kicker,hero_title_before,hero_title_highlight,hero_title_after,hero_description,cta_kicker,cta_title,cta_description,cta_button_label,cta_button_url,seo_title,seo_description&limit=1'),
      ]).then(([servicesResult, pageResult]) => {
        if (servicesResult.status === 'fulfilled') applyServices(servicesResult.value?.data);
        if (pageResult.status === 'fulfilled') applyPageContent(pageResult.value?.data?.[0]);
        document.body.dataset.cmsReady = 'true';
      }).catch(() => {
        document.body.dataset.cmsReady = 'fallback';
      });
    })();
  </script>
</body>
</html>

<style>
  :global(body.services-page){
    margin:0;
    min-width:320px;
    color:#15161a;
    background:
      radial-gradient(circle at 12% 16%,rgba(102,74,218,.08),transparent 25%),
      radial-gradient(circle at 90% 42%,rgba(89,117,255,.06),transparent 26%),
      #fbfaf7;
    font-family:'Vazirmatn',Tahoma,sans-serif;
    overflow-x:hidden;
  }
  :global(.services-page *){box-sizing:border-box}
  :global(.services-page a){color:inherit;text-decoration:none}
  .services-shell{width:min(1240px,calc(100% - 48px));margin-inline:auto}

  .services-header{position:sticky;top:0;z-index:30;padding:18px 0;background:linear-gradient(#fbfaf7f5,#fbfaf7d9,transparent);backdrop-filter:blur(14px)}
  .services-nav-wrap{min-height:72px;padding:0 22px;border:1px solid rgba(20,23,31,.11);border-radius:22px;background:rgba(255,255,255,.72);display:flex;align-items:center;justify-content:space-between;gap:28px;box-shadow:0 18px 55px rgba(28,31,50,.05)}
  .services-brand{display:flex;align-items:center;gap:11px;direction:ltr;flex:none}
  .services-brand svg{width:48px;height:39px}
  .services-brand path{fill:none;stroke:#17181c;stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
  .services-brand .echo{stroke:#6b49d9;stroke-width:2;opacity:.7}
  .services-brand strong{font-size:1.3rem;letter-spacing:-.04em}
  .services-nav-wrap nav{display:flex;align-items:center;gap:clamp(10px,1.6vw,25px);font-size:.93rem;font-weight:700}
  .services-nav-wrap nav a{position:relative;padding:11px 1px;color:#555b69;transition:.2s}
  .services-nav-wrap nav a:hover,.services-nav-wrap nav a.active{color:#17181c}
  .services-nav-wrap nav a::after{content:'';position:absolute;right:50%;left:50%;bottom:4px;height:2px;border-radius:20px;background:#6d4be2;transition:.25s}
  .services-nav-wrap nav a:hover::after,.services-nav-wrap nav a.active::after{right:6%;left:6%}

  .services-hero{padding:clamp(72px,10vw,150px) 0 clamp(58px,7vw,94px);display:grid;grid-template-columns:minmax(0,1.18fr) minmax(310px,.82fr);align-items:end;column-gap:60px}
  .hero-kicker{grid-column:1/-1;display:flex;align-items:center;gap:10px;color:#6c7282;font-size:.9rem;margin-bottom:26px}
  .hero-kicker span{display:block;width:38px;height:1px;background:#6d4be2}
  .hero-kicker b{font-weight:800}
  .services-hero h1{margin:0;color:#101116;font-size:clamp(52px,7.1vw,100px);line-height:1.05;letter-spacing:-.055em;font-weight:800}
  .services-hero h1 em{font-style:normal;color:#6948dc}
  .hero-copy{display:flex;flex-direction:column;align-items:flex-start;gap:24px;padding-bottom:5px}
  .hero-copy p{margin:0;color:#5e6472;font-size:clamp(16px,1.28vw,19px);line-height:2.05;max-width:520px}
  .hero-action{display:inline-flex;align-items:center;gap:32px;padding:13px 18px 13px 13px;border-bottom:1px solid #17181c;font-weight:800}
  .hero-action span{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:#17181c;color:white}

  .services-intro{padding:20px 0 52px;border-top:1px solid rgba(20,23,31,.12);display:grid;grid-template-columns:.35fr 1fr;gap:40px;align-items:start}
  .services-intro span{font:700 .72rem/1.4 Arial,sans-serif;letter-spacing:.16em;color:#777d89;padding-top:8px}
  .services-intro p{margin:0;max-width:780px;color:#252832;font-size:clamp(20px,2vw,31px);line-height:1.75;font-weight:700;letter-spacing:-.025em}

  .services-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid rgba(20,23,31,.14);border-right:1px solid rgba(20,23,31,.14)}
  .service-card{min-height:500px;padding:38px clamp(28px,3.4vw,52px) 38px;border-left:1px solid rgba(20,23,31,.14);border-bottom:1px solid rgba(20,23,31,.14);background:rgba(255,255,255,.32);transition:transform .3s,background .3s,box-shadow .3s;position:relative;overflow:hidden;display:flex;flex-direction:column}
  .service-card::before{content:'';position:absolute;width:190px;height:190px;border-radius:50%;left:-95px;bottom:-115px;background:radial-gradient(circle,rgba(103,74,220,.13),transparent 70%);opacity:0;transition:.3s}
  .service-card.featured::after{content:'CORE';position:absolute;top:24px;left:28px;font:700 .62rem/1 Arial,sans-serif;letter-spacing:.14em;color:#6846db;border:1px solid rgba(104,70,219,.22);border-radius:999px;padding:6px 8px;background:#fff}
  .service-card:hover{background:rgba(255,255,255,.78);transform:translateY(-4px);box-shadow:0 22px 60px rgba(29,32,49,.07)}
  .service-card:hover::before{opacity:1}
  .service-topline{display:flex;align-items:center;justify-content:space-between;margin-bottom:46px;color:#858b98}
  .service-number{font-size:.8rem;font-weight:800;letter-spacing:.08em}
  .service-icon{display:grid;place-items:center;width:52px;height:52px;border:1px solid rgba(20,23,31,.13);border-radius:16px;color:#6948dc;font-size:1.45rem;background:#fff}
  .service-card h2{margin:0 0 15px;color:#17181c;font-size:clamp(27px,2.3vw,37px);line-height:1.35;letter-spacing:-.03em}
  .service-summary{margin:0;color:#4f5563;line-height:1.95;font-size:1rem;max-width:550px}
  .service-details{margin:17px 0 0;color:#7b808b;line-height:1.9;font-size:.88rem;max-width:560px}
  .service-bottom{margin-top:auto;padding-top:30px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
  .service-tags{display:flex;flex-wrap:wrap;gap:7px;direction:ltr;justify-content:flex-end}
  .service-tags span{padding:6px 10px;border:1px solid rgba(20,23,31,.1);border-radius:999px;color:#737987;background:#ffffff9e;font-size:.7rem;font-weight:700}
