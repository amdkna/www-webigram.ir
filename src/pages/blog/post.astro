---
import '../../styles/base.css';
import '../../styles/content-pages.css';
const base = import.meta.env.BASE_URL;
const cmsUrl = 'https://cms.webigram.ir';
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="index, follow" />
  <meta name="description" content="مقاله وبیگرام" data-page-description />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <title>بلاگ | Webigram</title>
</head>
<body>
  <header class="cp-header"><div class="cp-shell cp-nav"><a class="cp-brand" href={`${base}`}><svg viewBox="0 0 64 52"><path d="M4 7 16 45 28 14l8 31L60 7"/><path class="echo" d="M7 9 17 41 28 17l8 25L57 9"/></svg><span>Webigram</span></a><nav><a href={`${base}`}>خانه</a><a href={`${base}services/`}>خدمات</a><a href={`${base}portfolio/`}>نمونه کارها</a><a class="active" href={`${base}blog/`}>بلاگ</a><a href={`${base}contact/`}>تماس</a></nav></div></header>
  <main class="article-wrap">
    <article><header class="article-hero"><div class="cp-kicker" data-category>ARTICLE</div><h1 data-title>در حال دریافت مطلب…</h1><p class="article-excerpt" data-excerpt></p><div class="article-meta" data-meta></div></header><img class="article-cover" data-cover alt="" hidden /><div class="article-content" data-content></div><div class="article-tags" data-tags></div></article>
  </main>
  <footer class="article-wrap cp-footer"><span>Webigram</span><span><a href="/blog/">← همه مطالب</a></span></footer>
  <script define:vars={{ cmsUrl }} is:inline>
    (()=>{
      const esc=(value='')=>String(value).replace(/[&<>'"]/g,(ch)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
      const slug=decodeURIComponent(location.pathname.replace(/^\/blog\//,'').replace(/\/$/,'')).trim();
      const faDate=(value)=>{if(!value)return'';try{return new Intl.DateTimeFormat('fa-IR',{year:'numeric',month:'long',day:'numeric'}).format(new Date(value));}catch{return'';}};
      const fail=()=>{document.querySelector('[data-title]').textContent='مطلب پیدا نشد';document.querySelector('[data-excerpt]').textContent='ممکن است مطلب منتشر نشده باشد یا آدرس آن تغییر کرده باشد.';};
      if(!slug||slug==='post'){fail();return;}
      const fields='id,slug,title,excerpt,content,cover_image,author_name,published_at,reading_minutes,seo_title,seo_description,category_id.id,category_id.name,category_id.slug,tags.id,tags.sort,tags.blog_tag_id.id,tags.blog_tag_id.name,tags.blog_tag_id.slug';
      fetch(`${cmsUrl}/items/blog_posts?filter[slug][_eq]=${encodeURIComponent(slug)}&limit=1&fields=${encodeURIComponent(fields)}`,{headers:{Accept:'application/json'},cache:'no-store'}).then((r)=>{if(!r.ok)throw new Error();return r.json();}).then(({data})=>{const p=data?.[0];if(!p){fail();return;}document.title=p.seo_title||`${p.title} | Webigram`;const d=document.querySelector('[data-page-description]');d.content=p.seo_description||p.excerpt||'';document.querySelector('[data-category]').textContent=p.category_id?.name||'بلاگ وبیگرام';document.querySelector('[data-title]').textContent=p.title;document.querySelector('[data-excerpt]').textContent=p.excerpt||'';const meta=[p.author_name,faDate(p.published_at),p.reading_minutes?`${p.reading_minutes} دقیقه مطالعه`:null].filter(Boolean);document.querySelector('[data-meta]').innerHTML=meta.map((x)=>`<span>${esc(x)}</span>`).join('<span>•</span>');const cover=document.querySelector('[data-cover]');if(p.cover_image){cover.src=`${cmsUrl}/assets/${encodeURIComponent(p.cover_image)}?width=1600&quality=88`;cover.alt=p.title;cover.hidden=false;}document.querySelector('[data-content]').innerHTML=p.content||'<p>متن این مطلب هنوز تکمیل نشده است.</p>';const tags=(p.tags||[]).map((x)=>x.blog_tag_id).filter(Boolean);document.querySelector('[data-tags]').innerHTML=tags.map((t)=>`<span class="cp-pill"># ${esc(t.name)}</span>`).join('');}).catch(fail);
    })();
  </script>
</body>
</html>
