---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import { services, site } from '../data/site';

const steps = [
  {
    title: 'ایده شما، نقطه آغاز است',
    text: 'هر پروژه از یک نیاز، مسئله یا ایده آغاز می‌شود. شما ایده را مطرح می‌کنید؛ ما آن را بررسی می‌کنیم تا مسیر تبدیل آن به یک راهکار واقعی مشخص شود.',
  },
  {
    title: 'مسیر اجرا را طراحی می‌کنیم',
    text: 'نیازها را تحلیل می‌کنیم، ساختار و تجربه کاربری را شکل می‌دهیم و ایده را به یک طرح روشن، منسجم و قابل اجرا تبدیل می‌کنیم.',
  },
  {
    title: 'آن را به واقعیت تبدیل می‌کنیم',
    text: 'از طراحی و توسعه تا استقرار و بهبود، طرح نهایی را به یک وب‌سایت، اپلیکیشن، سامانه یا ابزار اختصاصی واقعی و قابل استفاده تبدیل می‌کنیم.',
  },
];

const principles = [
  { title: 'اول مسئله، بعد تکنولوژی', text: 'لازم نیست بدانید چه نرم‌افزاری می‌خواهید. مسئله و نتیجه مورد انتظار را می‌شنویم و مسیر فنی را ما طراحی می‌کنیم.' },
  { title: 'از طرح تا استقرار، یک تیم', text: 'طراحی، توسعه، زیرساخت و استقرار در یک مسیر یکپارچه جلو می‌رود؛ بدون گم شدن جزئیات بین چند تیم.' },
  { title: 'ساخته‌شده برای ماندن', text: 'راهکاری می‌سازیم که قابل اتکا، قابل توسعه و قابل نگهداری باشد؛ نه فقط برای روز تحویل.' },
];
---
<SiteLayout description={site.description} current="home" canonical="https://webigram.ir/">
  <main>
  <!-- Hero -->
  <section class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <span class="eyebrow">وبیگرام · از ایده تا اجرای واقعی</span>
        <h1>ایده شما را به <em class="text-gradient">واقعیت</em> تبدیل می‌کنیم</h1>
        <p>از طراحی و توسعه تا استقرار و بهبود؛ ایده شما را به یک وب‌سایت، اپلیکیشن، سامانه یا ابزار اختصاصی واقعی و قابل استفاده تبدیل می‌کنیم.</p>
        <div class="home-hero__actions">
          <a class="btn btn--primary" href="/contact/">شروع همکاری <span class="arrow">←</span></a>
          <a class="btn btn--secondary" href="/portfolio/">مشاهده نمونه‌کارها</a>
        </div>
        <ul class="home-hero__facts" aria-label="حوزه‌های کاری">
          <li>DevOps و زیرساخت</li>
          <li>اتوماسیون</li>
          <li>پلتفرم و وب</li>
          <li>هوش مصنوعی</li>
        </ul>
      </div>
      <div class="home-hero__art">
        <HeroArt />
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section section--soft" id="process" aria-labelledby="process-title">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">مسیر اجرا</span>
          <h2 id="process-title">از ایده تا محصول، در سه قدم روشن</h2>
        </div>
      </header>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="card step">
            <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">خدمات</span>
          <h2 id="services-title">برای هر مسئله، راه‌حل درست</h2>
          <p>از زیرساخت و DevOps تا اتوماسیون، پلتفرم، پنل سازمانی و وب‌سایت؛ دقیقا همان چیزی را می‌سازیم که لازم است.</p>
        </div>
        <a class="link-arrow" href="/services/">همه خدمات <span>←</span></a>
      </header>
      <div class="service-grid">
        {services.map((service) => (
          <a class="card service-tile" href={`/services/#${service.slug}`}>
            <span class="service-tile__icon" aria-hidden="true">{service.icon}</span>
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
            <span class="service-tile__more">بیشتر بخوانید <span aria-hidden="true">←</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects (from CMS) -->
  <section class="section section--soft" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">نمونه‌کارها</span>
          <h2 id="projects-title">هر پروژه، یک روایت</h2>
          <p>از مسئله‌ای که مطرح شد تا تصمیم‌هایی که گرفته شد و محصولی که در نهایت شکل گرفت.</p>
        </div>
        <a class="link-arrow" href="/portfolio/">همه پروژه‌ها <span>←</span></a>
      </header>
      <div class="project-grid" data-projects>
        <div class="project-empty">در حال دریافت پروژه‌ها…</div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container about">
      <div class="about__intro">
        <span class="eyebrow">درباره وبیگرام</span>
        <h2 id="about-title">ما چیزی را می‌سازیم که واقعا به کار بیاید</h2>
        <p>وبیگرام تیمی برای طراحی، توسعه و راه‌اندازی راهکارهای دیجیتال است. هر پروژه با شناخت مسئله شروع می‌شود و ترکیب خدمات بر اساس همان مسئله شکل می‌گیرد.</p>
      </div>
      <ul class="about__list">
        {principles.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section home-cta" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2 id="cta-title">یک مسئله یا ایده دارید؟</h2>
          <p>مسئله و نتیجه مورد انتظار را بگویید؛ مسیر فنی را با هم پیدا می‌کنیم.</p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--light" href="/contact/">شروع گفتگو <span class="arrow">←</span></a>
          <a class="btn btn--ghost-light" href="/services/">آشنایی با خدمات</a>
        </div>
      </div>
    </div>
  </section>
  </main>

  <script define:vars={{ cmsUrl: site.cmsUrl }} is:inline>
    (() => {
      const list = document.querySelector('[data-projects]');
      if (!list) return;
      const esc = (value = '') => String(value).replace(/[&<>'"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[ch]));
      const asset = (id) => id ? `${cmsUrl}/assets/${encodeURIComponent(id)}?width=800&height=500&fit=cover&quality=82` : '';
      const fields = 'id,slug,title,summary,client,year,service,cover_image,featured';
      const empty = (text) => { list.innerHTML = `<div class="project-empty">${text} <a class="link-arrow" href="/portfolio/">صفحه نمونه‌کارها ←</a></div>`; };
      fetch(`${cmsUrl}/items/portfolio?filter[status][_eq]=published&sort=-featured,sort,title&limit=3&fields=${encodeURIComponent(fields)}`, { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then((response) => { if (!response.ok) throw new Error(`CMS ${response.status}`); return response.json(); })
        .then(({ data }) => {
          const items = Array.isArray(data) ? data : [];
          if (!items.length) { empty('روایت پروژه‌ها به‌زودی اینجا منتشر می‌شود.'); return; }
          list.innerHTML = items.map((item) => {
            const image = asset(item.cover_image);
            const meta = [item.service, item.year].filter(Boolean).map((value) => `<span class="chip">${esc(value)}</span>`).join('');
            return `<a class="card project-card" href="/portfolio/${encodeURIComponent(item.slug)}/">
              <div class="project-card__cover">${image ? `<img src="${image}" alt="" loading="lazy" />` : '<span aria-hidden="true">W</span>'}</div>
              <div class="project-card__body">
                <div class="project-card__meta">${meta}</div>
                <h3>${esc(item.title)}</h3>
                <p>${esc(item.summary || '')}</p>
                ${item.client ? `<span class="project-card__client">${esc(item.client)}</span>` : ''}
              </div>
            </a>`;
          }).join('');
        })
        .catch(() => empty('فعلا امکان دریافت پروژه‌ها نیست.'));
    })();
  </script>
</SiteLayout>

<style>
  /* Hero */
  .home-hero { padding-block: clamp(32px, 6vw, 80px) clamp(56px, 8vw, 104px); overflow: hidden; }
  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .home-hero__copy h1 { font-size: var(--fs-h1); line-height: 1.2; }
  .home-hero__copy p { max-width: 520px; margin-top: var(--sp-5); font-size: var(--fs-md); }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }
  .home-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: var(--sp-7) 0 0;
    padding: var(--sp-5) 0 0;
    border-top: 1px solid var(--c-line);
    list-style: none;
    color: var(--c-muted);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  .home-hero__facts li { display: inline-flex; align-items: center; gap: var(--sp-2); }
  .home-hero__facts li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--gradient-brand); }

  /* Process */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); margin: 0; padding: 0; list-style: none; }
  .step { padding: var(--sp-6); }
  .step__num {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--sp-5);
    border-radius: var(--radius);
    background: var(--c-primary-soft);
    color: var(--c-primary);
    font-weight: var(--fw-black);
  }
  .step h3 { font-size: var(--fs-h3); margin-bottom: var(--sp-3); }

  /* Services */
  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
  .service-tile { display: flex; flex-direction: column; padding: var(--sp-6); }
  .service-tile__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--sp-5);
    border-radius: var(--radius);
    background: var(--gradient-brand);
    color: #fff;
    font-size: 1.3rem;
  }
  .service-tile h3 { font-size: var(--fs-lg); margin-bottom: var(--sp-3); }
  .service-tile p { color: var(--c-text); font-size: .95rem; }
  .service-tile__more { margin-top: auto; padding-top: var(--sp-5); color: var(--c-primary); font-size: var(--fs-sm); font-weight: var(--fw-bold); }

  /* Projects */
  .project-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); }
  .project-grid :global(.project-card) { display: flex; flex-direction: column; overflow: hidden; }
  .project-grid :global(.project-card__cover) {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #eef0ff, #f6f0ff);
    color: rgba(71, 87, 255, .35);
    font-size: 3rem;
    font-weight: var(--fw-black);
  }
  .project-grid :global(.project-card__cover img) { width: 100%; height: 100%; object-fit: cover; }
  .project-grid :global(.project-card__body) { display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-5); flex: 1; }
  .project-grid :global(.project-card__meta) { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .project-grid :global(.project-card h3) { font-size: var(--fs-lg); }
  .project-grid :global(.project-card p) { font-size: .95rem; }
  .project-grid :global(.project-card__client) { margin-top: auto; color: var(--c-muted); font-size: var(--fs-sm); font-weight: var(--fw-bold); }
  .project-grid :global(.project-empty) {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    padding: var(--sp-8) var(--sp-5);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-muted);
    text-align: center;
  }

  /* About */
  .about { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .about__intro h2 { font-size: var(--fs-h2); }
  .about__intro p { margin-top: var(--sp-5); font-size: var(--fs-md); }
  .about__list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .about__list li { padding: var(--sp-5) 0; border-bottom: 1px solid var(--c-line); }
  .about__list li:first-child { padding-top: 0; }
  .about__list h3 { font-size: var(--fs-lg); margin-bottom: var(--sp-2); }

  .home-cta { padding-top: 0; }

  /* Tablet and mobile */
  @media (max-width: 1024px) {
    .service-grid, .project-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .home-hero__grid { grid-template-columns: 1fr; }
    .home-hero__copy { text-align: center; }
    .home-hero__copy p { margin-inline: auto; }
    .home-hero__actions, .home-hero__facts { justify-content: center; }
    .home-hero__copy .eyebrow::before { display: none; }
    .home-hero__art { max-width: 640px; width: 100%; margin-inline: auto; }
    .steps { grid-template-columns: 1fr; }
    .about { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .service-grid, .project-grid { grid-template-columns: 1fr; }
    .home-hero__actions .btn { flex: 1 1 100%; }
    .home-hero__facts { display: none; }
    .step, .service-tile { padding: var(--sp-5); }
  }
</style>
