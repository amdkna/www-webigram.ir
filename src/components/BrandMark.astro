---
/** The Webigram "W" logo with wordmark. `id` keeps the gradient unique per instance. */
interface Props { id?: string; href?: string; label?: string }
const { id = 'brand', href = '/', label = 'وبیگرام - صفحه اصلی' } = Astro.props;
const gradientId = `${id}-gradient`;
---
<a class="brand" href={href} aria-label={label}>
  <svg class="brand-mark" viewBox="0 0 64 52" aria-hidden="true">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2f5bff" />
        <stop offset="1" stop-color="#8b3dff" />
      </linearGradient>
    </defs>
    <path class="stroke-main" stroke={`url(#${gradientId})`} d="M4 7 16 45 28 14l8 31L60 7" />
    <path class="stroke-echo" d="M7 9 17 41 28 17l8 25L57 9" />
  </svg>
  <span>Webigram</span>
</a>
