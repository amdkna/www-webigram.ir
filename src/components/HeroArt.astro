---
/**
 * Homepage hero artwork: the same composition shown as a pencil sketch,
 * a colour design and the real product. Scrolling through the parent
 * [data-story] section wipes from one stage to the next, and the matching
 * [data-story-copy] block is shown beside it. The artwork scales to any width.
 */
import '../styles/composition.css';
import Composition from './Composition.astro';

const stages = [
  { key: 'sketch', label: 'ایده اولیه' },
  { key: 'color', label: 'طراحی' },
  { key: 'real', label: 'نسخه واقعی' },
] as const;
---
<figure class="hero-art" data-stage="0" data-hero-art>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <filter id="pencil-rough"><feTurbulence type="fractalNoise" baseFrequency=".014" numOctaves="2" seed="7" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale=".65"/></filter>
  </svg>

  <div class="hero-art__frame" data-hero-frame>
    <div class="hero-art__canvas" data-hero-canvas>
      <div class="hero-art__layer slide slide-sketch" data-layer="0">
        <div class="visual visual-sketch"><Composition variant="sketch" /></div>
      </div>
      <div class="hero-art__layer slide slide-color" data-layer="1" aria-hidden="true">
        <div class="visual visual-color"><Composition variant="color" /></div>
      </div>
      <div class="hero-art__layer slide slide-real" data-layer="2" aria-hidden="true">
        <div class="visual visual-real">
          <div class="real-composition-shell"><Composition variant="real" live /></div>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="hero-art__dots" aria-label="مراحل اجرای پروژه">
    {stages.map((stage, index) => (
      <a href={['#sketch', '#color', '#real'][index]} data-story-jump={index} aria-label={stage.label} aria-current={index === 0 ? 'step' : undefined}></a>
    ))}
  </figcaption>
</figure>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-hero-art]');
    if (!root) return;
    const story = root.closest('[data-story]');
    const frame = root.querySelector('[data-hero-frame]');
    const canvas = root.querySelector('[data-hero-canvas]');
    const layers = [...root.querySelectorAll('[data-layer]')];
    const steps = [...root.querySelectorAll('.hero-art__dots [data-story-jump]')];
    const copies = story ? [...story.querySelectorAll('[data-story-copy]')] : [];
    const live = root.querySelector('.live-composition');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const DESIGN_WIDTH = 1162;
    const LAST = layers.length - 1;
    // Transitions happen over the first 80% of the scroll distance; the rest holds the real product.
    const TRANSITION_END = .8;
    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    // Scale the fixed-size artwork to the frame.
    const fit = () => canvas.style.setProperty('--hero-scale', String(frame.clientWidth / DESIGN_WIDTH));
    new ResizeObserver(fit).observe(frame);
    fit();

    const scrollRange = () => {
      const pin = story.firstElementChild;
      return Math.max(1, story.offsetHeight - pin.offsetHeight);
    };

    let stage = -1;
    const setStage = (next) => {
      if (next === stage) return;
      stage = next;
      root.dataset.stage = story.dataset.stage = String(stage);
      // The first stage ("idea") is shown in greyscale across the whole page chrome (see site.css).
      document.documentElement.dataset.heroStage = String(stage);
      steps.forEach((step, index) => { if (index === stage) step.setAttribute('aria-current', 'step'); else step.removeAttribute('aria-current'); });
      copies.forEach((copy, index) => {
        const active = index === stage;
        copy.classList.toggle('is-active', active);
        copy.toggleAttribute('inert', !active);
        copy.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      layers.forEach((layer, index) => layer.setAttribute('aria-hidden', index === stage ? 'false' : 'true'));
      live?.toggleAttribute('data-live-playing', stage === LAST && !reduced.matches);
    };

    // Desktop homepage header: while the hero is on screen it sits above the text column
    // and scrolls away together with the hero. Once it has left the screen, the normal
    // full-width bar slides in from the top (see site.css). Scrolling back reverses it.
    const header = document.querySelector('[data-site-header]');
    const desktop = matchMedia('(min-width: 961px)');
    const placeHeader = () => {
      const html = document.documentElement;
      if (!header || !desktop.matches) {
        html.dataset.header = '';
        if (header) header.style.transform = '';
        return;
      }
      const frameH = Math.min(innerHeight, innerWidth / 1.776833);
      const heroHeaderBottom = (innerHeight - frameH) / 2 + frameH * .165;
      const exit = Math.max(0, innerHeight - story.getBoundingClientRect().bottom);
      if (exit < heroHeaderBottom) {
        html.dataset.header = 'hero';
        header.style.transform = exit ? `translateY(${-exit}px)` : '';
      } else {
        html.dataset.header = '';
        header.style.transform = '';
      }
    };
    desktop.addEventListener('change', () => placeHeader());

    let raf = 0;
    const render = () => {
      raf = 0;
      if (!story) { setStage(LAST); return; }
      const raw = clamp(-story.getBoundingClientRect().top / scrollRange(), 0, 1);
      const progress = clamp(raw / TRANSITION_END, 0, 1) * LAST;
      // Each layer sits on top of the next one and is wiped away from the bottom up.
      layers.forEach((layer, index) => {
        const cover = index < LAST ? clamp(progress - index, 0, 1) : 0;
        layer.style.clipPath = `inset(0 0 ${(cover * 100).toFixed(2)}% 0)`;
        layer.style.zIndex = String(layers.length - index);
      });
      setStage(Math.round(progress));
      placeHeader();
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(render); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    window.visualViewport?.addEventListener('resize', queue);
    render();

    // Buttons and step labels jump to the scroll position of that stage.
    document.addEventListener('click', (event) => {
      const link = event.target.closest('[data-story-jump]');
      if (!link || !story) return;
      event.preventDefault();
      const n = clamp(Number(link.dataset.storyJump), 0, LAST);
      const top = story.getBoundingClientRect().top + scrollY + scrollRange() * TRANSITION_END * (n / LAST);
      scrollTo({ top: Math.ceil(top) + 1, behavior: reduced.matches ? 'auto' : 'smooth' });
    });
  })();
</script>

<style is:global>
  .hero-art { position: relative; margin: 0; }

  .hero-art__frame {
    position: relative;
    aspect-ratio: 1162 / 1080;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: #fbfaf7;
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  .hero-art__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1162px;
    height: 1080px;
    transform: scale(var(--hero-scale, .5));
    transform-origin: top left;
    direction: ltr;
  }

  .hero-art__layer.slide {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: clip-path;
  }
  .hero-art__layer .visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Stage dots float over the bottom of the artwork, like the original. */
  .hero-art__dots {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: clamp(10px, 3%, 28px);
    transform: translateX(-50%);
    display: flex;
    gap: 7px;
    padding: 7px 9px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, .78);
    backdrop-filter: blur(10px);
    box-shadow: 0 6px 20px rgba(14, 18, 48, .08);
    direction: ltr;
  }
  .hero-art__dots a {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pill);
    background: rgba(14, 18, 48, .22);
    transition: width .3s var(--ease), background .3s;
  }
  .hero-art__dots a[aria-current='step'] { width: 30px; background: var(--c-ink); }
  .hero-art[data-stage='1'] .hero-art__dots a[aria-current='step'] { background: #315cff; }
  .hero-art[data-stage='2'] .hero-art__dots a[aria-current='step'] { background: #7b43ff; }</style>
